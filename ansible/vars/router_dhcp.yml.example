---
# DHCP Reservations for Homelab Devices
# Copy this file to router_dhcp.yml and fill in actual MAC addresses
# NOTE: Point router DNS to the laptop or monitoring Pi only if you actually deploy Pi-hole there

dhcp_reservations:
  - name: "netgear-gs308ep"
    mac: "XX:XX:XX:XX:XX:XX"  # Get from switch label
    ip: "192.168.8.2"
  
  - name: "homelab-laptop"
    mac: "XX:XX:XX:XX:XX:XX"  # Run: ip link show on the laptop
    ip: "192.168.8.10"
  
  - name: "monitoring-pi"
    mac: "XX:XX:XX:XX:XX:XX"  # Run: cat /sys/class/net/eth0/address on the Pi
    ip: "192.168.8.20"
